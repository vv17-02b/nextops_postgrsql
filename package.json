{
  "private": true,
  "name": "nextops_postgrsql",
  "version": "1.0.0",
  "workspaces": [
    "nextops-backend",
    "nextops-frontend"
  ],
  "scripts": {
    "backend": "cd nextops-backend && yarn start:dev",
    "frontend": "cd nextops-frontend && yarn dev -- --turbo",
    "start:dev": "concurrently \"yarn backend\" \"yarn frontend\"",
    "db:validate": "yarn --cwd nextops-backend prisma:validate",
    "db:generate": "yarn --cwd nextops-backend prisma:generate",
    "build": "yarn workspaces run build",
    "typecheck": "yarn workspaces run typecheck",
    "db:migrate": "yarn --cwd nextops-backend prisma migrate deploy"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^9.2.1"
  }
}
