{
 

  "Tailwind Grid map": {
    "prefix": "gridmap",
    "body": [
      "<div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 mt-20 w-[80%] mx-auto gap-6\">",
      "\t{${1:items}.map((${2:item}) => (",
      "\t\t<div key={${2}.id} className=\"p-4 bg-white rounded-lg shadow\">",
      "\t\t\t${0}",
      "\t\t</div>",
      "\t))}",
      "</div>"
    ]
  },

  "useState Hook": {
    "prefix": "us",
    "body": [
      "const [${1:state}, set${1/(.*)/${1:/capitalize}/}] = useState(${2:null});"
    ]
  },

  "useEffect async": {
    "prefix": "ue",
    "body": [
      "useEffect(() => {",
      "\tconst load = async () => {",
      "\t\ttry {",
      "\t\t\t${0}",
      "\t\t} catch (e) {",
      "\t\t\tconsole.error(e);",
      "\t\t}",
      "\t};",
      "",
      "\tload();",
      "}, []);"
    ]
  },

  "Modal Full": {
    "prefix": "modal",
    "body": [
      "const [isOpen, setIsOpen] = useState(false);",
      "",
      "{isOpen && (",
      "\t<div className=\"fixed inset-0 bg-black/50 flex items-center justify-center\">",
      "\t\t<div className=\"bg-white p-6 rounded-lg w-[400px]\">",
      "\t\t\t${0}",
      "\t\t\t<button onClick={() => setIsOpen(false)} className=\"mt-4 px-4 py-2 bg-blue-600 text-white rounded\">Close</button>",
      "\t\t</div>",
      "\t</div>",
      ")}"
    ]
  },
  
  "Navbar bg on scroll": {
    "prefix": "navscroll",
    "body": [
      "const [${1:navBg}, set${1/(.*)/${1:/capitalize}/}] = useState(false);",
      "",
      "useEffect(() => {",
      "\tconst handler = () => {",
      "\t\tset${1/(.*)/${1:/capitalize}/}(window.scrollY >= ${2:90});",
      "\t};",
      "",
      "\twindow.addEventListener('scroll', handler);",
      "\treturn () => window.removeEventListener('scroll', handler);",
      "}, []);"
    ],
    "description": "Toggle state on scroll position (navbar background)"
  },
"Return map render": {
  "prefix": "rmapr",
  "body": [
    "return ${1:items}.map((${2:item}, ${3:index}) => (",
    "\t<${4:div} key={${3}}>{${2}}</${4}>",
    "));"
  ],
  "description": "Return JSX array from map"
}
