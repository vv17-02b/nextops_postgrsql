datasource db {
  provider = "mongodb"
   url      = env("MONGO_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. ТАРИФНІ ПЛАНИ ДЛЯ МОНЕТИЗАЦІЇ ПЛАТФОРМИ
enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("DEVELOPER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Поля фінансового білінгу та лімітів SaaS
  plan                Plan      @default(FREE)
  stripeCustomerId    String?
  subscriptionActive  Boolean   @default(false)
  subscriptionExpires DateTime?

  accounts Account[]
  sessions Session[]
  projects Project[]
  webhooks WebhookConfig[]
}

model ApiHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?   @db.ObjectId
  method    String
  url       String
  headers   String?
  body      String?
  response  String?
  status    Int
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 2. МОДЕРНІЗОВАНА МОДЕЛЬ ДЛЯ ШІ-АГЕНТІВ ТА БЮДЖЕТІВ (Вікно №1)
model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  title       String
  description String?
  budget      Float    @default(0.0) // Фінансовий ліміт або витрати ШІ-агента
  status      String   @default("PLANNING") // PLANNING, ACTIVE, COMPLETED, SUSPENDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}

// 3. НОВА МОДЕЛЬ ДЛЯ АВТОМАТИЗАЦІЇ ТА ВЕБХУКІВ (Вікно №2)
model WebhookConfig {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  targetEvent String // Наприклад: "PROJECT_COMPLETED", "AI_TRIGGER"
  targetUrl   String // Адреса відправки (Telegram URL / CRM endpoint)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
