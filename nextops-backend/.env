# 1. Рядок підключення до вашої PostgreSQL
DATABASE_URL="postgresql://postgres:nextops123456@localhost:5432/nextops_db?schema=public"

# 2. Секретний ключ для шифрування токенів JWT (має бути довгим)
JWT_SECRET="super-secret-key-nextops-2026-long-bytes-stable-32-characters"


# 3. Активація локального детермінованого AI-аналізатора
AI_ENABLED="true"
API_HISTORY_RETENTION_DAYS=30

# 4. КРИТИЧНО НЕОБХІДНІ НАЛАШТУВАННЯ ДЛЯ ЗВ'ЯЗКУ З ФРОНТЕНДОМ (CORS ТА КУКИ):
CORS_ORIGINS="*"
FRONTEND_URL="http://localhost:3000"
# AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SAME_SITE="none"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_DOMAIN=""

BOOTSTRAP_ADMIN_EMAIL="admin@nextops.local"
BOOTSTRAP_ADMIN_PASSWORD="nextops123456789"


REDIS_URL="redis://localhost:6379"
CSRF_ENABLED="false"

