datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_stat_statements]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Company {
  id                 String               @id @default(uuid())
  name               String
  createdAt          DateTime             @default(now())
  users              User[]
  accounts           Account[]
  knowledgeBase      AgentKnowledgeBase[]
  apiHistory         ApiHistory[]
  categories         Category[]
  orders             Order[]
  orderItems         OrderItem[]
  products           Product[]
  projects           Project[]
  reviews            Review[]
  sessions           Session[]
  aiBudgets          UserAiBudget[]
  verificationTokens VerificationToken[]
  warehouses         Warehouse[]
  webhookConfigs     WebhookConfig[]
  invitations        Invitation[]
}

model Account {
  id                String  @id @default(uuid())
  companyId         String
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([id, companyId])
  @@index([companyId, userId])
}

model AgentKnowledgeBase {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  title     String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, projectId])
}

model ApiHistory {
  id           String   @id @default(uuid())
  companyId    String?
  userId       String?
  endpoint     String
  method       String
  statusCode   Int
  requestBody  String?
  responseBody String?
  durationMs   Int
  createdAt    DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId, companyId], references: [id, companyId], onDelete: SetNull)

  @@unique([id, companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, statusCode, createdAt(sort: Desc)])
}

model Category {
  id          String     @id @default(uuid())
  companyId   String
  name        String
  slug        String
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId, companyId], references: [id, companyId], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([id, companyId])
  @@unique([companyId, slug])
}
model Order {
  id                 String      @id @default(uuid())
  companyId          String
  userId             String
  status             String      @default("PENDING")
  paymentStatus      String      @default("UNPAID")
  paymentMethod      String      @default("CARD")
  paymentId          String?
  paymentRawResponse Json?
  totalAmountMinor   Int
  currency           String      @default("USD")
  shippingAddress    Json
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, paymentStatus, createdAt(sort: Desc)])
}

model OrderItem {
  id         String  @id @default(uuid())
  companyId  String
  orderId    String
  productId  String
  quantity   Int
  priceMinor Int

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId, companyId], references: [id, companyId], onDelete: Cascade)
  product Product @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, orderId])
  @@index([companyId, productId])
}

model Product {
  id                  String      @id @default(uuid())
  companyId           String
  name                String
  slug                String
  description         String?
  priceMinor          Int
  compareAtPriceMinor Int?
  images              String[]
  isActive            Boolean     @default(true)
  categoryId          String?
  category            Category?   @relation(fields: [categoryId, companyId], references: [id, companyId], onDelete: Restrict)
  orderItems          OrderItem[]
  reviews             Review[]
  inventory           Warehouse[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  company             Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([id, companyId])
  @@unique([companyId, slug])
  @@index([companyId, isActive, createdAt(sort: Desc)])
  @@index([companyId, categoryId, isActive])
}

model Project {
  id            String               @id @default(uuid())
  companyId     String
  userId        String
  name          String
  description   String?
  knowledgeBase AgentKnowledgeBase[]
  webhooks      WebhookConfig[]
  aiBudgets     UserAiBudget[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, userId])
}

model Review {
  id        String   @id @default(uuid())
  companyId String
  rating    Int
  comment   String?
  userId    String
  productId String
  user      User     @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  product   Product  @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([id, companyId])
  @@index([companyId, productId, createdAt(sort: Desc)])
}

model Session {
  id           String   @id @default(uuid())
  companyId    String
  sessionToken String   @unique
  userId       String
  expires      DateTime
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, userId])
}
model User {
  id            String         @id @default(uuid())
  companyId     String
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          String         @default("MEMBER")
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  projects      Project[]
  apiHistory    ApiHistory[]
  aiBudgets     UserAiBudget[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([id, companyId])
  @@index([companyId, createdAt])
}

model UserAiBudget {
  id                String   @id @default(uuid())
  companyId         String
  userId            String
  projectId         String?
  monthlyLimitMinor Int      @default(0)
  currentUsageMinor Int      @default(0)
  resetDate         DateTime
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId, companyId], references: [id, companyId], onDelete: Cascade)
  project           Project? @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([id, companyId])
  @@index([companyId, userId])
}

model VerificationToken {
  id         String   @id @default(uuid())
  companyId  String
  identifier String
  token      String   @unique
  expires    DateTime
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
  @@unique([id, companyId])
  @@index([companyId, expires])
}

model Warehouse {
  id        String   @id @default(uuid())
  companyId String
  productId String
  location  String
  quantity  Int      @default(0)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@unique([productId, location])
  @@unique([id, companyId])
  @@index([companyId, productId])
}

model WebhookConfig {
  id        String   @id @default(uuid())
  companyId String
  projectId String
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId, companyId], references: [id, companyId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([id, companyId])
  @@index([companyId, projectId, isActive])
}

model Invitation {
  id         String    @id @default(uuid())
  companyId  String
  email      String
  role       String    @default("MEMBER")
  tokenHash  String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([id, companyId])
  @@unique([companyId, email])
  @@index([companyId, expiresAt])
}
